      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lockguard_lock_wait_duration_seconds_bucket[1m])))",
          "legendFormat": ""
