<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Background worker host. All the work happens in hosted services from the Infrastructure layer, which send
    ScanDeadlocksCommand / ReclaimStaleLocksCommand through MediatR while this instance is the elected leader.
    The Web SDK is only used to expose /metrics (Prometheus) and /health.
  -->
  <PropertyGroup>
    <RootNamespace>LockGuard.Detector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LockGuard.Application\LockGuard.Application.csproj" />
    <ProjectReference Include="..\LockGuard.Infrastructure\LockGuard.Infrastructure.csproj" />
  </ItemGroup>

</Project>
