{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "LockGuard": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "TimestampFormat": "HH:mm:ss.fff " }
    }
  },
  "AllowedHosts": "*",
  "LockGuard": {
    "ServiceName": "lockguard-api",
    "Store": "Redis",
    "Redis": {
      "Endpoints": [ "localhost:6379", "localhost:6380", "localhost:6381" ],
      "CoordinationNodeIndex": 0,
      "KeyPrefix": "lg:",
      "ClockDriftFactor": 0.01,
      "NodeTimeout": "00:00:00.250"
    },
    "Acquisition": {
      "LeaseTime": "00:00:10",
      "WaitTimeout": "00:00:30",
      "InitialRetryDelay": "00:00:00.025",
      "MaxRetryDelay": "00:00:00.400"
    },
    "Watchdog": {
      "Enabled": true,
      "RenewalRatio": 0.33,
      "TickInterval": "00:00:00.500"
    },
    "Heartbeat": { "Interval": "00:00:02" },
    "Detection": {
      "Enabled": false,
      "ScanInterval": "00:00:01",
      "ConfirmationScans": 2,
      "WaitRecordStaleAfter": "00:00:05",
      "VictimForceReleaseAfter": "00:00:05"
    },
    "Reclaimer": {
      "Enabled": false,
      "ScanInterval": "00:00:02",
      "InstanceStaleAfter": "00:00:10",
      "MinLockAge": "00:00:03",
      "MaxHoldTime": "00:05:00"
    }
  }
}
